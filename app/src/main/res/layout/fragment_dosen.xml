<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <EditText
            android:id="@+id/edtNamaDosen"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Nama dosen"
            android:inputType="textPersonName" />

        <EditText
            android:id="@+id/edtEmailDosen"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Email dosen"
            android:inputType="textEmailAddress" />

        <EditText
            android:id="@+id/edtNidn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="NIDN" />

        <EditText
            android:id="@+id/edtMataKuliah"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Mata kuliah, pisahkan dengan koma"
            android:inputType="textCapSentences" />

        <Button
            android:id="@+id/btnSimpanDosen"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Simpan Dosen" />

        <TextView
            android:id="@+id/txtPesanDosen"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="6dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="12dp"
            android:text="Daftar Dosen"
            android:textSize="20sp"
            android:textStyle="bold" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvDosen"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:nestedScrollingEnabled="false" />

    </LinearLayout>
</ScrollView>
